# config.env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to config.env and fill in your values before running any
# scripts. config.env is git-ignored and never committed.
#
#   cp config.env.example config.env
#   # edit config.env
#   source config.env
#
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS ──────────────────────────────────────────────────────────────────────
export AWS_REGION="us-east-1"
export S3_BUCKET="your-name-llm-checkpoints"          # S3 bucket for checkpoints + data

# EC2 launch configuration (used by scripts/launch_spot.sh)
export AMI_ID="ami-xxxxxxxxxxxxxxxxx"                  # Deep Learning OSS Nvidia Driver AMI
                                                       # GPU PyTorch — find at:
                                                       # EC2 > Launch Instance > search "Deep Learning OSS Nvidia"
export INSTANCE_TYPE="g5.xlarge"                       # A10G 24GB, ~$1/hr. Alternative: g6e.xlarge (L40S, ~$3.80/hr)
export SPOT_PRICE="0.60"                               # Max spot bid. On-demand for g5.xlarge ~$1.006/hr
export KEY_NAME="your-ec2-key-pair-name"               # EC2 key pair name (without .pem)
export SECURITY_GROUP_ID="sg-xxxxxxxxxxxxxxxxx"        # Security group ID (SSH from your IP only)
export SUBNET_ID="subnet-xxxxxxxxxxxxxxxxx"            # Subnet ID in your chosen AZ
export IAM_INSTANCE_PROFILE="LLMTrainingProfile"       # IAM instance profile with S3 + SSM access

# ── HuggingFace ───────────────────────────────────────────────────────────────
export HF_USERNAME="your-hf-username"
export HF_REPO="${HF_USERNAME}/your-model-name"        # e.g. your-hf-username/llm-350m-instruct

# ── Weights & Biases ──────────────────────────────────────────────────────────
export WANDB_ENTITY="your-wandb-username"
export WANDB_PROJECT="llm-350m-finetune"

# ── GitHub ────────────────────────────────────────────────────────────────────
export GITHUB_USERNAME="your-github-username"
export GITHUB_REPO="${GITHUB_USERNAME}/llm-350m"       # Your fork of this repo

# ── SSM Parameter Names ───────────────────────────────────────────────────────
# Store your API tokens in AWS SSM Parameter Store (SecureString):
#   aws ssm put-parameter --name "/llm/wandb_key" --value "your-key" --type SecureString
#   aws ssm put-parameter --name "/llm/hf_token"  --value "hf_..."   --type SecureString
export SSM_WANDB_KEY="/llm/wandb_key"
export SSM_HF_TOKEN="/llm/hf_token"
